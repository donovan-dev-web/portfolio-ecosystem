        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          },
          "dateSent": {
            "type": "string",
            "format": "date-time"
          },
          "dateRead": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectTypeSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Nom du type de projet"
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "description": "Icone représentant le type de projet"
          }
        },
        "required": [
          "name",
          "icon"
        ]
