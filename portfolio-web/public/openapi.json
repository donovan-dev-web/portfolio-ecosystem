{
  "openapi": "3.0.0",
  "info": {
    "title": "Portfolio Ecosystem API",
    "version": "1.0.0",
    "description": "Documentation OpenAPI de l API du portfolio de Donovan Chartrain : projets, messages, documents, tags, authentification et notifications."
  },
  "servers": [
    {
      "url": "https://donovan-dev-web.vercel.app/api",
      "description": "API serverless du portfolio public et des interfaces d administration"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email de l'utilisateur"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Mot de passe de l'utilisateur"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "ID de l'utilisateur"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email de l'utilisateur"
          },
          "token": {
            "type": "string",
            "description": "JWT d'authentification"
          }
        },
        "required": [
          "userId",
          "email",
          "token"
        ]
      },
      "ChangePasswordBody": {
        "type": "object",
        "properties": {
          "oldPassword": {
            "type": "string",
            "minLength": 8,
            "description": "Ancien mot de passe de l'utilisateur"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "description": "Nouveau mot de passe de l'utilisateur"
          }
        },
        "required": [
          "oldPassword",
          "newPassword"
        ]
      },
      "SignupResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Message de confirmation"
          }
        },
        "required": [
          "message"
        ]
      },
      "SignupBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email de l'utilisateur"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Mot de passe de l'utilisateur"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignupStatusResponse": {
        "type": "object",
        "properties": {
          "signupEnabled": {
            "type": "boolean",
            "description": "Etat d activation de la route signup"
          }
        },
        "required": [
          "signupEnabled"
        ]
      },
      "UpdateUserBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Nouvel email de l'utilisateur"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Nouveau mot de passe optionnel"
          }
        },
        "required": [
          "email"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID de l'utilisateur"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email de l'utilisateur"
          },
          "createdAt": {
            "type": "string",
            "description": "Date de creation"
          },
          "updatedAt": {
            "type": "string",
            "description": "Date de mise a jour"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "UsersListResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/UserResponse"
        }
      },
      "DocType": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "cv"
            ]
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "pathname": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "downloadCount": {
            "type": "number"
          },
          "lastDownloadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProgrammingLanguageType": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": false
          },
          "icon": {
            "type": "string",
            "nullable": false
          },
          "createdAt": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "MessageType": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          },
          "dateSent": {
            "type": "string",
            "format": "date-time"
          },
          "dateRead": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectTypeSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Nom du type de projet"
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "description": "Icone représentant le type de projet"
          }
        },
        "required": [
          "name",
          "icon"
        ]
      },
      "ProjectRecordType": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "nullable": true
          },
          "slug": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": false
          },
          "order": {
            "type": "number",
            "nullable": false
          },
          "projectType": {
            "type": "string",
            "nullable": false
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": false
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": false
          },
          "shortDescription": {
            "type": "string",
            "nullable": false
          },
          "coverImage": {
            "type": "object",
            "properties": {
              "small": {
                "type": "string"
              },
              "medium": {
                "type": "string"
              },
              "large": {
                "type": "string"
              }
            },
            "nullable": false
          },
          "stack": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "presentation": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "objectives": {
                "type": "string"
              },
              "skills": {
                "type": "string"
              },
              "results": {
                "type": "string"
              },
              "improvements": {
                "type": "string"
              }
            },
            "nullable": false
          },
          "gallery": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "desktop": {
                  "type": "object",
                  "properties": {
                    "small": {
                      "type": "string"
                    },
                    "medium": {
                      "type": "string"
                    },
                    "large": {
                      "type": "string"
                    }
                  }
                },
                "mobile": {
                  "type": "object",
                  "properties": {
                    "small": {
                      "type": "string"
                    },
                    "medium": {
                      "type": "string"
                    },
                    "large": {
                      "type": "string"
                    }
                  }
                },
                "alt": {
                  "type": "string"
                }
              }
            },
            "nullable": true
          },
          "githubUrl": {
            "type": "string",
            "nullable": true
          },
          "isLive": {
            "type": "boolean",
            "nullable": true
          },
          "liveUrl": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "TechnologySchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Nom de la technologie"
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "description": "Icone représentant la technologie"
          }
        },
        "required": [
          "name",
          "icon"
        ]
      },
      "ProgrammingLanguageSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Nom du langage de programmation"
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "description": "Icone représentant le langage"
          }
        },
        "required": [
          "name",
          "icon"
        ]
      }
    },
    "responses": {
      "400": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Invalid request parameters"
                },
                "code": {
                  "type": "string",
                  "example": "400"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Authentication required"
                },
                "code": {
                  "type": "string",
                  "example": "401"
                }
              }
            }
          }
        }
      },
      "403": {
        "description": "Forbidden",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Access denied"
                },
                "code": {
                  "type": "string",
                  "example": "403"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Resource not found"
                },
                "code": {
                  "type": "string",
                  "example": "404"
                }
              }
            }
          }
        }
      },
      "409": {
        "description": "Conflict",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Resource already exists"
                },
                "code": {
                  "type": "string",
                  "example": "409"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "An unexpected error occurred"
                },
                "code": {
                  "type": "string",
                  "example": "500"
                }
              }
            }
          }
        }
      }
    }
  },
  "showDeveloperTools": "never",
