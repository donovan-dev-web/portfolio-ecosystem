{
  "name": "portoflio-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "productName": "PortfolioAdmin",
  "description": "Admin dashboard du portfolio de Donovan CHARTRAIN",
  "author": {
    "name": "Donovan CHARTRAIN",
    "email": "donovan.chartrain@gmail.com"
  },
  "homepage": "https://donovan-dev-web.vercel.app",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",

    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:4200 && ELECTRON_DEV=true electron .\"",

    "electron:build": "npm run build && electron-builder"
  },

  "build": {
    "appId": "com.portfolio.admin",
    "productName": "PortfolioAdmin",

    "directories": {
      "output": "release"
    },

    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "node_modules/**/*"
    ],

    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "maintainer": "Donovan Chartrain <donovan.chartrain@gmail.com>"
    }
  },

  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "axios": "^1.13.5",
    "framer-motion": "^12.33.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "react-toastify": "^11.0.5"
  },

  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^40.4.1",
    "electron-builder": "^21.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "3.8.1",
    "sass": "^1.97.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^7.2.4",
    "wait-on": "^9.0.4"
  }
}